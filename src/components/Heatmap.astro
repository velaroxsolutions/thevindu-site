---
// GitHub's contribution graph, redrawn from the real calendar (see lib/live/contributions.ts).
import { heatmapHTML } from '../lib/heatmap';
import type { Contributions } from '../lib/live/contributions';
interface Props { contrib: Contributions }
const { contrib } = Astro.props;
---
<div class="ghcal" data-live="heatmap" set:html={heatmapHTML(contrib.days, contrib.total)} />
<script>import '../scripts/ghcal';</script>
