---
interface Props { crumbs: { href?: string; label: string }[]; title: string; lede?: string; meta?: string[] }
const { crumbs, title, lede, meta = [] } = Astro.props;
---
<div class="phead" data-sec="top" data-secname="Top">
  <nav class="crumb" aria-label="Breadcrumb">
    {crumbs.map((c, i) => (
      <>
        {i > 0 && <span class="sep">/</span>}
        {c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}
      </>
    ))}
  </nav>
  <h1 class="rv"><span>{title}</span></h1>
  {lede && <p class="lede-xl" set:html={lede} />}
  <slot />
  {meta.length > 0 && <div class="metarow">{meta.map((m) => <span class="lbl scr" set:html={m} />)}</div>}
</div>
