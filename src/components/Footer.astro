---
import { execSync } from 'node:child_process';
import { SITE } from '../data/site';
let sha = process.env.VERCEL_GIT_COMMIT_SHA?.slice(0, 7);
if (!sha) { try { sha = execSync('git rev-parse --short HEAD', { stdio: ['ignore', 'pipe', 'ignore'] }).toString().trim(); } catch { sha = 'local'; } }
const built = new Date().toISOString().slice(0, 10);
---
<footer class="foot">
  <div class="w">
    <div class="foot-row">
      <span class="lbl">{SITE.name} · {SITE.location}</span>
      <nav class="foot-links" aria-label="Footer">
        <a href="/log">Log</a><a href="/notes">Notes</a><a href="/rss.xml">RSS</a><a href="/cv">Résumé</a>
        {SITE.socials.map((s) => <a href={s.href} target="_blank" rel="noopener">{s.label} ↗</a>)}
      </nav>
    </div>
    <div class="foot-mark" aria-hidden="true">THE<span>V</span></div>
    <div class="foot-row">
      <span class="lbl">Build {sha} · {built}</span>
      <span class="lbl">Built by hand, set in Archivo</span>
    </div>
  </div>
</footer>
