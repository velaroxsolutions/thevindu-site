---
// Chess: the FIDE rating is the headline (official, typed in by hand — FIDE has no API).
// Chess.com and Lichess are sidenotes: one rating each, the time control played most, live.
import type { Chess } from '../lib/live/chess';
import { PROFILES } from '../data/profiles';
import { NOW } from '../data/now';
import { fmtDate } from '../lib/content';
interface Props { ch: Chess | null; i?: number }
const { ch, i = 4 } = Astro.props;
const { fide } = NOW.panel;
const online = [
  { site: 'Chess.com', key: 'chesscom', href: PROFILES.chesscom.url, main: ch?.chesscom?.main },
  { site: 'Lichess', key: 'lichess', href: PROFILES.lichess.url, main: ch?.lichess?.main },
].filter((o) => o.main);
---
<div class="cell c-chess" data-anim style={`--i:${i}`} data-lane-item="study">
  <div class="kboard" aria-hidden="true">
    {Array.from({ length: 25 }, (_, k) => <i class={(Math.floor(k / 5) + (k % 5)) % 2 ? 'd' : ''} />)}
    <span class="kdot"></span><span class="knight">&#9822;&#xFE0E;</span>
  </div>
  <span class="lbl"><span>Chess · FIDE</span><span>For fun</span></span>
  <a class="fide" href={fide.url} target="_blank" rel="noopener">
    <span class="cell-big"><span class="count" data-to={fide.standard}>0</span></span>
    <span class="fide-tc">Standard</span>
    <span class="fide-sub"><b>{fide.blitz}</b> blitz · as of {fmtDate(new Date(fide.asOf), { month: 'short', year: 'numeric' })}</span>
  </a>
  {online.length > 0 && (
    <small class="chess-side">
      <span>Online</span>
      {online.map((o) => (
        <a href={o.href} target="_blank" rel="noopener">{o.site} <b data-live={`chess-${o.key}-main`}>{o.main!.r}</b> <em data-live={`chess-${o.key}-main-k`}>{o.main!.k}</em></a>
      ))}
    </small>
  )}
</div>
