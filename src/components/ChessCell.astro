---
import Sparkline from './Sparkline.astro';
import type { Chess } from '../lib/live/chess';
import { PROFILES } from '../data/profiles';
import { NOW } from '../data/now';
interface Props { ch: Chess | null; i?: number }
const { ch, i = 4 } = Astro.props;
const { fide } = NOW.panel;
const hist = ch?.lichess?.history ?? [];
---
<a class="cell c-chess" href={fide.url} target="_blank" rel="noopener" data-anim style={`--i:${i}`} data-lane-item="study">
  <span class="lbl"><span>Chess · FIDE standard</span><span>For fun</span></span>
  <span class="cell-big"><span class="count" data-to={fide.standard}>0</span></span>
  {hist.length > 1
    ? <Sparkline points={hist.map((x) => x.r)} label="Lichess" />
    : <div class="board" aria-hidden="true">{Array.from({ length: 64 }, (_, k) => <i class={k === 27 ? 'q' : (Math.floor(k / 8) + k) % 2 ? 'd' : ''} />)}</div>}
  <small class="chess-line">
    <span>blitz {fide.blitz}</span>
    <span>chess.com <b data-live="chesscom-rapid">{ch?.chesscom?.rapid ?? '—'}</b></span>
    <span>lichess <b data-live="lichess-rapid">{ch?.lichess?.rapid ?? ch?.lichess?.blitz ?? '—'}</b></span>
  </small>
</a>
