---
import Mark from './Mark.astro';
import Lanes from './Lanes.astro';
import { SITE, NAV } from '../data/site';
import { PROFILES } from '../data/profiles';
import { appstore } from '../lib/live';
const app = await appstore();
const { lanes = true } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => path === href || path.startsWith(href + '/');
---
<header class="top">
  <div class="w top-in">
    <a class="brand" href="/" aria-label="Home"><Mark /><span>{SITE.short}</span></a>
    <nav class="main" aria-label="Main">
      {NAV.map((n) => <a href={n.href} aria-current={isActive(n.href) ? 'page' : undefined}>{n.label}</a>)}
    </nav>
    <div class="top-right">
      <a class="topchip" href={app?.url ?? PROFILES.appstore.url} target="_blank" rel="noopener"><i class="dot"></i>Aperis{app ? ` v${app.version}` : ''} on the App Store</a>
      {lanes && <Lanes />}
      <button class="kbd" id="palbtn" aria-label="Open command palette (Ctrl K)"><span class="kmod">⌘</span>K</button>
      <button class="iconbtn theme" data-theme-toggle aria-label="Toggle dark mode">
        <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
      <a class="cvlink" href="/cv">Résumé</a>
      <button class="iconbtn burger" id="menubtn" aria-label="Open menu" aria-expanded="false" aria-controls="menu">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 8h16M4 16h16"/></svg>
      </button>
    </div>
  </div>
</header>

<div class="menu" id="menu" role="dialog" aria-modal="true" aria-label="Menu">
  <button class="iconbtn menu-x" id="menux" aria-label="Close menu">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6l12 12M18 6L6 18"/></svg>
  </button>
  <nav aria-label="Mobile">
    <a href="/" style="--i:0" aria-current={path === '/' ? 'page' : undefined}><small>00</small>Home</a>
    {NAV.map((n, i) => <a href={n.href} style={`--i:${i + 1}`} aria-current={isActive(n.href) ? 'page' : undefined}><small>{String(i + 1).padStart(2, '0')}</small>{n.label}</a>)}
    <a href="/cv" style={`--i:${NAV.length + 1}`}><small>{String(NAV.length + 1).padStart(2, '0')}</small>Résumé</a>
  </nav>
  <div class="menu-foot">
    {lanes && <Lanes />}
    <div class="menu-links">
      <button class="btn" data-open-palette>Search ⌘K</button>
      <button class="btn" data-theme-toggle>Toggle theme</button>
      {SITE.socials.map((s) => <a class="btn ghost" href={s.href} target="_blank" rel="noopener">{s.label} ↗</a>)}
    </div>
  </div>
</div>
