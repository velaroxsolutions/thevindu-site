---
import Base from '../../layouts/Base.astro';
import { render } from 'astro:content';
import { notes, fmtDate } from '../../lib/content';
export async function getStaticPaths() {
  const all = await notes();
  return all.map((n, i) => ({ params: { slug: n.id }, props: { n, newer: all[i - 1], older: all[i + 1] } }));
}
const { n, newer, older } = Astro.props;
const { Content, headings } = await render(n);
const words = (n.body ?? '').split(/\s+/).length;
const toc = headings.filter((h) => h.depth === 2);
---
<Base title={n.data.title} description={n.data.dek} type="article" lanes={false}>
  <div class="phead" data-sec="top" data-secname="Top">
    <nav class="crumb" aria-label="Breadcrumb"><a href="/">Home</a><span class="sep">/</span><a href="/notes">Notes</a><span class="sep">/</span><span aria-current="page">{fmtDate(n.data.date)}</span></nav>
    <h1 class="rv" style="font-size:clamp(36px,6vw,78px);max-width:16ch"><span>{n.data.title}</span></h1>
    <p class="lede-xl" style="max-width:30ch;font-size:clamp(19px,2.4vw,28px);color:var(--body-ink)">{n.data.dek}</p>
    <div class="metarow">
      <span class="lbl">{fmtDate(n.data.date, { month: 'long', day: 'numeric', year: 'numeric' })}</span>
      <span class="lbl">{Math.max(1, Math.round(words / 220))} min read</span>
      <span class="lbl" style={`color:var(--${n.data.lane})`}>{n.data.lane}</span>
      {n.data.tags.map((t) => <span class="lbl">#{t}</span>)}
    </div>
  </div>
  <section style="padding-top:clamp(30px,4vw,60px)" data-sec="body" data-secname="Note">
    <div class="article">
      <nav class="sidenav" aria-label="Sections">
        {toc.length > 0 && <span class="lbl">Contents</span>}
        {toc.map((h, i) => <a href={`#${h.slug}`} class={i === 0 ? 'on' : ''}>{h.text}</a>)}
      </nav>
      <article class="prose"><Content /></article>
    </div>
    <nav class="pnav" aria-label="More notes">
      {newer ? <a href={`/notes/${newer.id}`}><span class="lbl">← Newer</span><b>{newer.data.title}</b></a> : <a href="/notes"><span class="lbl">←</span><b>All notes</b></a>}
      {older ? <a href={`/notes/${older.id}`}><span class="lbl">Older →</span><b>{older.data.title}</b></a> : <a href="/log"><span class="lbl">→</span><b>The log</b></a>}
    </nav>
  </section>
</Base>
