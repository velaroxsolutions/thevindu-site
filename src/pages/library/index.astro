---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Chapter from '../../components/Chapter.astro';
import { libraryCounts, libraryLatest } from '../../lib/content';
const c = await libraryCounts();
const latest = await libraryLatest(5);
---
<Base title="Library" description="Templates, course summaries, and book notes. Free, no email required.">
  <PageHead crumbs={[{ href: '/', label: 'Home' }, { label: 'Library' }]} title="Library"
    lede="Everything I learn, <em>given away</em>. No email gate, no catch.">
    <div class="stats" style="margin-top:clamp(40px,6vw,74px)">
      <div class="stat b" data-anim><b><span class="count" data-to={c.total}>0</span></b><span>Items</span></div>
      <div class="stat" data-anim style="--i:1"><b><span class="count" data-to={c.templates}>0</span></b><span>Templates</span></div>
      <div class="stat s" data-anim style="--i:2"><b><span class="count" data-to={c.courses}>0</span></b><span>Course notes</span></div>
      <div class="stat" data-anim style="--i:3"><b><span class="count" data-to={c.books}>0</span></b><span>Books</span></div>
    </div>
  </PageHead>

  <section data-sec="cats" data-secname="Browse">
    <Chapter num="01" title="Browse" />
    <div class="grid3">
      <a class="card ret" href="/library/templates" data-lane-item="build" data-anim><span class="arrow">↗</span>
        <span class="kcount">{c.templates} templates</span><h3>Templates</h3><p>Starting points for software, AI, and content work.</p></a>
      <a class="card ret" href="/library/courses" data-lane-item="study" data-anim style="--i:1"><span class="arrow">↗</span>
        <span class="kcount">{c.courses} courses</span><h3>Course notes</h3><p>Lectures condensed into sheets I study from.</p></a>
      <a class="card ret" href="/library/books" data-lane-item="study" data-anim style="--i:2"><span class="arrow">↗</span>
        <span class="kcount">{c.books} books</span><h3>Books</h3><p>What I read and whether it was worth it.</p></a>
    </div>
  </section>

  <section data-sec="latest" data-secname="Latest">
    <Chapter num="02" title="Latest" sub="Newest additions, across everything." />
    <div class="res">
      {latest.map((l, i) => (
        <a class="ritem" href={l.href} data-anim style={`--i:${i}`} data-lane-item={l.type === 'Course' ? 'study' : 'build'}>
          <div><h3>{l.title}</h3><p>{l.text}</p></div>
          <span class="rtype">{l.type}</span><span class="dl">Open →</span>
        </a>
      ))}
    </div>
  </section>
</Base>
