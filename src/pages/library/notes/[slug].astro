---
import Base from '../../../layouts/Base.astro';
import { noteRefs, notionPublicUrl } from '../../../lib/content';
import { notionHTML } from '../../../lib/live';
export async function getStaticPaths() {
  return (await noteRefs()).map((r) => ({ params: { slug: r.slug }, props: { r } }));
}
const { r } = Astro.props;
const page = (await notionHTML(r.notionId))!;
const words = page.html.replace(/<[^>]+>/g, ' ').split(/\s+/).filter(Boolean).length;
---
<Base title={`${r.title} — notes`} description={`My notes on ${r.title}.`} type="article" lanes={false}>
  <div class="phead" data-sec="top" data-secname="Top">
    <nav class="crumb" aria-label="Breadcrumb"><a href="/">Home</a><span class="sep">/</span><a href="/library">Library</a><span class="sep">/</span><a href={r.back.split('#')[0]}>{r.kind === 'book' ? 'Books' : 'Courses'}</a><span class="sep">/</span><span aria-current="page">Notes</span></nav>
    <h1 class="rv" style="font-size:clamp(34px,5.6vw,72px);max-width:18ch"><span>{r.title}</span></h1>
    <div class="metarow">
      <span class="lbl">{r.kind === 'book' ? 'Book summary' : 'Course notes'}</span>
      <span class="lbl">{Math.max(1, Math.round(words / 220))} min read</span>
      <a class="lbl" href={page.url || notionPublicUrl(r.notionId)} target="_blank" rel="noopener">Open in Notion ↗</a>
    </div>
  </div>
  <section style="padding-top:clamp(20px,3vw,40px)" data-sec="notes" data-secname="Notes">
    <article class="prose notion" set:html={page.html} />
    <p style="margin-top:48px"><a class="btn" href={r.back}>← Back</a></p>
  </section>
</Base>
