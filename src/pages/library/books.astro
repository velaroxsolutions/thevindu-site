---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Chapter from '../../components/Chapter.astro';
import Words from '../../components/Words.astro';
import Cover from '../../components/Cover.astro';
import { allBooks } from '../../lib/content';
import { PROFILES } from '../../data/profiles';
const all = await allBooks();
const verdicts = [...new Set(all.map((b) => b.verdict))];
const featured = all.find((b) => b.featured && b.quote);
const withTake = all.filter((b) => b.take && b !== featured);
const slug = (v: string) => v.toLowerCase().replace(/\s+/g, '-');
const fromNotion = all.filter((b) => b.source === 'notion').length;
---
<Base title="Books" description="What I've read and what I kept from it.">
  <PageHead crumbs={[{ href: '/', label: 'Home' }, { href: '/library', label: 'Library' }, { label: 'Books' }]} title="Books"
    lede="What I read, and whether I’d tell you to <em>bother</em>."
    meta={[`<span class="count" data-to="${all.length}">0</span> total`, fromNotion ? `${fromNotion} synced from Notion` : 'Honest verdicts']}>
    <div class="quick" style="margin-top:8px"><a class="btn mag" href={PROFILES.notion.reading.url} target="_blank" rel="noopener">Full reading notes on Notion ↗</a></div>
  </PageHead>

  <section style="padding-top:clamp(34px,4.5vw,56px)" data-sec="shelf" data-secname="Shelf">
    <Chapter num="01" title="The shelf" sub="An outlined cover means I’m in the middle of it. Filter by verdict." />
    {all.length === 0 && <p class="building-note">Being put together. Book notes are on their way.</p>}
    <div class="filters" hidden={all.length === 0} role="group" aria-label="Filter by verdict" id="bookfilter">
      <button data-v="all" aria-pressed="true">All<sup>{all.length}</sup></button>
      {verdicts.map((v) => <button data-v={slug(v)} aria-pressed="false">{v}<sup>{all.filter((b) => b.verdict === v).length}</sup></button>)}
    </div>
    <div class="wall">
      {all.map((b, i) => {
        const href = withTake.includes(b) ? `#${b.id}` : b.href;
        return (
          <a class={`wbook ${b.verdict === 'Reading' ? 'now' : ''}`} href={href} target={href?.startsWith('http') ? '_blank' : undefined} rel={href?.startsWith('http') ? 'noopener' : undefined}
             data-v={slug(b.verdict)} data-anim style={`--i:${i % 6}`}>
            <Cover title={b.title} author={b.author} src={b.cover} />
            <div class="wmeta"><strong>{b.title}</strong><span>{b.verdict}</span></div>
          </a>
        );
      })}
    </div>
  </section>

  {featured && (
    <Words sec="one" name="One line" text={featured.quote!}
      side={`<b style="color:var(--ink);font-weight:500">${featured.title}</b> — ${featured.author}. ${featured.take ?? ''}`} />
  )}

  {withTake.length > 0 && <section data-sec="notes" data-secname="Notes">
    <Chapter num="02" title="What I kept" sub="One line each. Not summaries — the bit that stuck." />
    <div class="books">
      {withTake.map((b, i) => (
        <div class="book" id={b.id} data-anim style={`--i:${i % 6}`}>
          <Cover title={b.title} src={b.cover} small />
          <div><h3>{b.href ? <a href={b.href} target="_blank" rel="noopener">{b.title} ↗</a> : b.title}</h3><p class="by">{b.author}</p><p class="take">{b.take}</p></div>
          <span class={`bstat ${b.verdict === 'Reading' ? 'now' : ''}`}>{b.verdict}</span>
        </div>
      ))}
      {all.filter((b) => !withTake.includes(b)).map((b) => <span id={b.id} />)}
    </div>
  </section>}
</Base>
<script>
  import { $$ } from '../../scripts/util';
  const btns = $$('#bookfilter button');
  btns.forEach((b) => b.addEventListener('click', () => {
    btns.forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
    $$('.wbook').forEach((w) => w.classList.toggle('hide', b.dataset.v !== 'all' && w.dataset.v !== b.dataset.v));
  }));
</script>
