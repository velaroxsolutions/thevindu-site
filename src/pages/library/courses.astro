---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Chapter from '../../components/Chapter.astro';
import { courses, fmtDate } from '../../lib/content';
const all = await courses();
const groups = [...new Set(all.map((c) => c.data.category))].map((name) => ({ name, items: all.filter((c) => c.data.category === name) }));
const certs = all.filter((c) => c.data.certificate).length;
const NOTION = 'https://thevindu.notion.site/Course-summaries-217870ccc7224762bb81d397472e93cc';
---
<Base title="Completed courses" description="Courses I've finished, grouped by what they taught.">
  <PageHead crumbs={[{ href: '/', label: 'Home' }, { href: '/library', label: 'Library' }, { label: 'Courses' }]} title="Courses"
    lede="Courses I’ve <em>actually finished</em>, alongside university."
    meta={[`<span class="count" data-to="${all.length}">0</span> completed`, `${certs} with certificates`, `${groups.length} areas`]}>
    <div class="quick" style="margin-top:8px"><a class="btn mag" href={NOTION} target="_blank" rel="noopener">My summaries on Notion ↗</a></div>
  </PageHead>

  {groups.map((g, gi) => (
    <section style={gi === 0 ? 'padding-top:clamp(34px,4.5vw,56px)' : ''} data-sec={`c${gi}`} data-secname={g.name.split(' ')[0]}>
      <Chapter num={String(gi + 1).padStart(2, '0')} title={g.name} sub={`${g.items.length} ${g.items.length === 1 ? 'course' : 'courses'}`} />
      <div class="certs">
        {g.items.map((c, i) => {
          const Tag = c.data.url ? 'a' : 'div';
          return (
            <Tag class={`cert ret ${c.data.certificate ? 'is-cert' : ''}`} id={c.id} href={c.data.url} target={c.data.url ? '_blank' : undefined} rel={c.data.url ? 'noopener' : undefined}
                 data-anim style={`--i:${i % 3}`} data-lane-item={c.data.lane}>
              <span class="cert-seal" aria-hidden="true"><svg viewBox="0 0 40 40"><circle cx="20" cy="20" r="17" /><path d="M13 20.5l4.5 4.5L27 15.5" /></svg></span>
              <span class="lbl">{[c.data.provider, c.data.date && fmtDate(c.data.date, { month: 'short', year: 'numeric' })].filter(Boolean).join(' · ') || 'Completed'}</span>
              <h3>{c.data.title}</h3>
              {c.data.topics.length > 0 && <div class="chips">{c.data.topics.map((t) => <span class="chip">{t}</span>)}</div>}
              {c.data.certificate && <span class="cert-badge">Certificate</span>}
              {c.data.url && <span class="dl">Open ↗</span>}
            </Tag>
          );
        })}
      </div>
    </section>
  ))}
</Base>
