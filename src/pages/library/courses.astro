---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Chapter from '../../components/Chapter.astro';
import Words from '../../components/Words.astro';
import { courses } from '../../lib/content';
const all = await courses();
---
<Base title="Course notes" description="My lecture notes, condensed into concept sheets. Free.">
  <PageHead crumbs={[{ href: '/', label: 'Home' }, { href: '/library', label: 'Library' }, { label: 'Courses' }]} title="Course notes"
    lede="My lectures, condensed into sheets I <em>actually study from</em>."
    meta={[`<span class="count" data-to="${all.length}">0</span> courses`, 'University of Alberta', 'Free']} />

  <section style="padding-top:clamp(34px,4.5vw,56px)" data-sec="all" data-secname="Courses">
    <Chapter num="01" title="All courses" />
    <div class="docs">
      {all.map((c, i) => {
        const Tag = c.data.pdf ? 'a' : 'div';
        return (
          <Tag class="doc" id={c.id} href={c.data.pdf} download={c.data.pdf ? '' : undefined} data-anim style={`--i:${i}`} data-lane-item="study">
            <div class="docpg"><b>{c.data.pages}pp</b><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
            <div class="docbody">
              <p class="code">{c.data.code}</p>
              <h3>{c.data.name}</h3>
              <p>{c.data.blurb}</p>
              <div class="docfoot"><span class="rtype">{c.data.pages} pages</span><span class="dl">{c.data.pdf ? 'Download ↓' : 'PDF coming'}</span></div>
            </div>
          </Tag>
        );
      })}
    </div>
  </section>

  <Words sec="why" name="Why"
    text="If these disagree with your instructor, <em>your instructor is right</em>."
    side="These are study aids, not authority. They’re shaped around where I got confused, which is sometimes useful to someone else and occasionally misleading." />
</Base>
