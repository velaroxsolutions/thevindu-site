---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Chapter from '../../components/Chapter.astro';
import { courses, fmtDate } from '../../lib/content';
const all = await courses();
---
<Base title="Completed courses" description="Courses and certificates I've finished.">
  <PageHead crumbs={[{ href: '/', label: 'Home' }, { href: '/library', label: 'Library' }, { label: 'Courses' }]} title="Courses"
    lede="Courses I’ve <em>actually finished</em>, and what each one gave me."
    meta={[`<span class="count" data-to="${all.length}">0</span> completed`, `Since ${all.length ? Math.min(...all.map((c) => c.data.date.getUTCFullYear())) : '—'}`]} />

  <section style="padding-top:clamp(34px,4.5vw,56px)" data-sec="all" data-secname="Courses">
    <Chapter num="01" title="Completed" sub="Mostly self-paced, alongside university." />
    {all.length ? (
      <div class="certs">
        {all.map((c, i) => {
          const Tag = c.data.url ? 'a' : 'div';
          return (
            <Tag class="cert ret" id={c.id} href={c.data.url} target={c.data.url ? '_blank' : undefined} rel={c.data.url ? 'noopener' : undefined} data-anim style={`--i:${i % 3}`} data-lane-item={c.data.lane}>
              <span class="cert-seal" aria-hidden="true"><svg viewBox="0 0 40 40"><circle cx="20" cy="20" r="17" /><path d="M13 20.5l4.5 4.5L27 15.5" /></svg></span>
              <span class="lbl">{c.data.provider} · {fmtDate(c.data.date, { month: 'short', year: 'numeric' })}</span>
              <h3>{c.data.title}</h3>
              {c.data.topics.length > 0 && <div class="chips">{c.data.topics.map((t) => <span class="chip">{t}</span>)}</div>}
              {c.data.url && <span class="dl">View certificate ↗</span>}
            </Tag>
          );
        })}
      </div>
    ) : <p class="building-note">Being put together. Course notes are on their way.</p>}
  </section>
</Base>
