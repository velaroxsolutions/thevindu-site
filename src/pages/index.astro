---
import Base from '../layouts/Base.astro';
import Field from '../components/Field.astro';
import Marquee from '../components/Marquee.astro';
import Chapter from '../components/Chapter.astro';
import Words from '../components/Words.astro';
import SkillsExplorer from '../components/SkillsExplorer.astro';
import { SITE } from '../data/site';
import { NOW } from '../data/now';
import Heatmap from '../components/Heatmap.astro';
import ChessCell from '../components/ChessCell.astro';
import { projects, logEntries, libraryCounts, lessons, allBooks, fmtDate } from '../lib/content';
import { TERM } from '../data/term';
import { github, chess, duolingo, appstore } from '../lib/live';
import { PROFILES } from '../data/profiles';

const [proj, log, counts, ns, bs, gh, ch, duo, app] = await Promise.all([projects(), logEntries(), libraryCounts(), lessons(), allBooks(), github(), chess(), duolingo(), appstore()]);
const shipped = log.find((l) => l.data.kind === 'Shipped');
const current = proj.find((p) => p.data.hot) ?? proj[0];
const reading = bs.find((b) => b.verdict === 'Reading');
const french = duo?.courses.find((c) => c.lang === 'fr');
const lastPush = gh?.activity[0];
const split = (s: string, off = 0) => [...s].map((c, i) => ({ c, k: i + off }));
const first = split('Thevindu'), last = split('Nagasinghe', 8);
const rgb = { build: '217,26,114', study: '43,76,232', neutral: '92,102,117' } as const;
---
<Base>
  <div class="hero" data-sec="top" data-secname="Top">
    <div class="hero-l">
      <div class="eyebrow">
        <span class="lbl scr">Edmonton</span>
        <span class="lbl scr">Computer Engineering ’28</span>
        <span class="lbl scr">University of Alberta</span>
      </div>
      <h1 class="name" id="name" aria-label={SITE.name}>
        <span class="ln" aria-hidden="true">{first.map(({ c, k }) => <span class="ch" style={`--k:${k}`}>{c}</span>)}</span>
        <span class="ln" aria-hidden="true">{last.map(({ c, k }) => <span class="ch" style={`--k:${k}`}>{c}</span>)}</span>
      </h1>
      <p class="status"><span class="live"><i class="dot"></i>Now</span><span>Building <a href={`/work/${current.id}`}>{current.data.title}</a>.</span></p>
      <p class="intro">
        I build things with software and AI under <a href="/work">Velarox</a>, mostly to solve problems I or the people around me actually have.
        Whatever I figure out along the way ends up in the <a href="/library">library</a>, free.
      </p>
      <div class="quick">
        {SITE.socials.map((s) => <a class="btn mag" href={s.href} target="_blank" rel="noopener">{s.label} ↗</a>)}
        <a class="btn mag" href="/cv">Résumé</a>
        <a class="btn primary mag" href="#contact">Say hello</a>
      </div>
    </div>
    <Field />
  </div>

  <Marquee />

  {/* VERIFY: draft pull-quote for Thev to approve */}
  <Words sec="belief" name="Belief"
    text="If I learned it the hard way, <em>you shouldn’t have to</em>."
    side="Most of what I know came from trial and error. Writing it down and giving it away is the least I can do with the errors." />

  <section id="now" data-sec="now" data-secname="Now">
    <Chapter num="01" title="State of things" sub="Updated when it changes, not on a schedule." more={{ href: '/log', label: 'Full log' }} />
    <div class="bento">
      <div class="cell c-now" data-anim>
        <span class="lbl"><span>Now</span><span>{fmtDate(new Date(NOW.updated))}</span></span>
        <div class="nowlist">
          {NOW.items.map((n) => <div data-lane-item={n.lane}><span>{n.label}</span><p>{n.text}</p></div>)}
        </div>
      </div>
      <div class="cell c-clock" data-anim style="--i:1">
        <span class="lbl"><span>Edmonton</span><span id="clkzone">MT</span></span>
        <span class="cell-big" id="clk">--:--</span>
        <small id="clkday">—</small>
        <div class="sky" aria-hidden="true">
          <svg viewBox="0 0 200 50" preserveAspectRatio="none"><line class="hz" x1="0" y1="46" x2="200" y2="46"/><path class="arc" d="M10 46 Q100 -30 190 46"/><circle class="sun" id="sun" r="4" cx="100" cy="8"/></svg>
        </div>
      </div>
      {shipped && (
        <a class="cell c-ship" href={`/log#${shipped.id}`} data-anim style="--i:2" data-lane-item="build">
          <span class="lbl"><span>Last shipped</span><span data-ago={shipped.data.date.toISOString()}>{fmtDate(shipped.data.date, { month: 'short', day: 'numeric' })}</span></span>
          <p class="cell-lead">{shipped.data.text}</p>
          <small>{shipped.data.project ?? 'Velarox'} · see the log →</small>
        </a>
      )}
      {gh && (
        <a class="cell c-gh" href={PROFILES.github.url} target="_blank" rel="noopener" data-anim style="--i:3" data-lane-item="build">
          <span class="lbl"><span>GitHub · @{PROFILES.github.user}</span><span>{gh.calendar ? `${gh.calendar.total} contributions` : `${gh.profile.repos} repos`}</span></span>
          {gh.calendar && <Heatmap days={gh.calendar.days} weeks={30} />}
          {lastPush && <small class="gh-last"><span class="gh-repo">{lastPush.repo.replace(`${PROFILES.github.user}/`, '')}</span> {lastPush.text} · <span data-ago={lastPush.at}>{fmtDate(new Date(lastPush.at), { month: 'short', day: 'numeric' })}</span></small>}
        </a>
      )}
      {gh && <ChessCell ch={ch} />}
      <div class="bento-tail">
        {!gh && <ChessCell ch={ch} />}
      {duo && (
        <a class="cell c-duo" href={duo.url} target="_blank" rel="noopener" data-anim style="--i:5" data-lane-item="study">
          <span class="lbl"><span>Duolingo streak</span><span>{french ? 'French' : duo.courses[0]?.title}</span></span>
          <span class="cell-big"><span class="count" data-to={duo.streak}>0</span><em class="unit">days</em></span>
          <div class="streak" aria-hidden="true">{Array.from({ length: 14 }, (_, i) => <i class={i < Math.min(14, duo.streak) ? 'on' : ''} style={`--k:${i}`} />)}</div>
          <small>{duo.xp.toLocaleString('en-CA')} XP{french ? ` · ${french.xp.toLocaleString('en-CA')} in French` : ''}</small>
        </a>
      )}
      {reading && (
        <a class="cell c-read" href={reading.href ?? `/library/books#${reading.id}`} data-anim style="--i:6" data-lane-item="study">
          <span class="lbl"><span>Reading</span><span>{counts.reading} open</span></span>
          <p class="cell-lead">{reading.title}</p>
          <small>{reading.author}</small>
        </a>
      )}
      {TERM.courses.length > 0 && (
        <a class="cell c-term" href="/about#term" data-anim style="--i:6" data-lane-item="study">
          <span class="lbl"><span>This term</span><span>{TERM.label}</span></span>
          <p class="cell-lead">{TERM.courses.length} courses</p>
          <small>{TERM.courses.map((c) => c.code).join(' · ')}</small>
        </a>
      )}      <a class="cell c-lib" href="/library" data-anim style="--i:7">
        <span class="lbl"><span>Library</span><span>Free</span></span>
        <span class="cell-big"><span class="count" data-to={counts.total}>0</span></span>
        <small>{[counts.books && `${counts.books} books`, counts.courses && `${counts.courses} courses`, counts.photos && `${counts.photos} photos`].filter(Boolean).join(' · ') || 'Being put together'}</small>
      </a>
      {app && (
        <a class="cell c-app" href={app.url} target="_blank" rel="noopener" data-anim style="--i:8" data-lane-item="build">
          <span class="lbl"><span>App Store</span><span>v{app.version}</span></span>
          <p class="cell-lead">{app.name}{app.rating ? <span class="stars"> ★ {app.rating.toFixed(1)}</span> : null}</p>
          <small>{app.genre} · {app.price} · updated <span data-ago={app.updated}>{fmtDate(new Date(app.updated))}</span></small>
        </a>
      )}
      </div>
    </div>
  </section>

  <section data-sec="work" data-secname="Work">
    <Chapter num="02" title="Building" sub="Things I’ve built under Velarox, mostly on my own." more={{ href: '/work', label: 'All work' }} />
    <div class="rows">
      {proj.map((p, i) => (
        <a class={`prow acc-${p.data.accent}`} href={`/work/${p.id}`} data-lane-item="build" data-anim style={`--i:${i}`}
           data-peek={p.data.title} data-peek-sub={p.data.status} data-peek-rgb={rgb[p.data.accent]}>
          <span class="pnum">{String(i + 1).padStart(2, '0')}</span>
          <div><p class="pname">{p.data.title}</p><p class="ptag">{p.data.tagline}</p></div>
          <div class="pbody">
            <p>{p.data.summary}</p>
            <div class="chips">{p.data.stack.map((s) => <span class="chip">{s}</span>)}</div>
          </div>
          <span class={`pstat ${p.data.hot ? 'hot' : ''}`}>{p.data.status}</span>
        </a>
      ))}
    </div>
  </section>

  <section id="skills" data-sec="skills" data-secname="Skills">
    <Chapter num="03" title="What I work in" sub="Search it. Click any row to see where it was used." />
    <SkillsExplorer />
  </section>

  {ns.length > 0 && (
    <section data-sec="lessons" data-secname="Lessons">
      <Chapter num="04" title="Lessons learnt" sub="Short and honest. The hard way, written down." more={{ href: '/lessons', label: 'All lessons' }} />
      <ol class="lessons">
        {ns.slice(0, 3).map((l, i) => (
          <li class="lesson" data-lane-item={l.data.lane} data-anim style={`--i:${i}`}>
            <span class="lesson-n">{String(ns.length - i).padStart(2, '0')}</span>
            <div><h3 class="lesson-t"><a href={`/lessons#${l.id}`}>{l.data.title}</a></h3><p class="lesson-c">{l.data.context}</p></div>
            <span class="lesson-m"><span class={`kind ${l.data.lane === 'build' ? 'Shipped' : 'Learned'}`}>{l.data.from ?? 'Life'}</span></span>
          </li>
        ))}
      </ol>
    </section>
  )}

  <section data-sec="library" data-secname="Library">
    <Chapter num="05" title="Library" sub="What I learn, given away. No email gate." more={{ href: '/library', label: 'Open the library' }} />
    <div class="grid3">
      <a class="card ret" href="/library/books" data-lane-item="study" data-anim>
        <span class="arrow">↗</span><span class="kcount">{counts.books ? <><span class="count" data-to={counts.books}>0</span> books</> : 'Coming soon'}</span>
        <h3>Books</h3><p>What I read and the one line I kept from each.</p></a>
      <a class="card ret" href="/library/courses" data-lane-item="study" data-anim style="--i:1">
        <span class="arrow">↗</span><span class="kcount"><span class="count" data-to={counts.courses}>0</span> completed</span>
        <h3>Courses</h3><p>Courses and certificates I’ve finished.</p></a>
      <a class="card ret" href="/photos" data-lane-item="build" data-anim style="--i:2">
        <span class="arrow">↗</span><span class="kcount">{counts.photos ? <><span class="count" data-to={counts.photos}>0</span> photos</> : `${PROFILES.pexels.views} views`}</span>
        <h3>Free photos</h3><p>Mostly nature. Free for anyone to use.</p></a>
    </div>
  </section>
</Base>
<script>import '../scripts/home';</script>
