---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Chapter from '../components/Chapter.astro';
import SkillsExplorer from '../components/SkillsExplorer.astro';
import { getCollection } from 'astro:content';
import { NOW } from '../data/now';
import { PHOTOS, HOBBIES } from '../data/about';
import { TERM } from '../data/term';
import Elsewhere from '../components/Elsewhere.astro';
import { photos } from '../lib/live';
import { localPhotos } from '../lib/localPhotos';
import { PROFILES } from '../data/profiles';

const tl = (await getCollection('timeline')).sort((a, b) => a.data.order - b.data.order);
const livePhotos = [...(await localPhotos()), ...((await photos())?.photos ?? [])];
const strip = livePhotos.length
  ? livePhotos.slice(0, 8).map((p) => ({ label: '', cap: p.alt, meta: 'Photo · Thevindu Nagasinghe', src: p.src, full: p.full }))
  : PHOTOS.map((p) => ({ ...p, full: p.src }));
---
<Base title="About" description="Computer engineering student in Edmonton. I build software under Velarox.">
  <PageHead crumbs={[{ href: '/', label: 'Home' }, { label: 'About' }]} title="About"
    lede="I learn by building, and I build things <em>I wish existed</em>."
    meta={['Edmonton', 'Grew up in Sri Lanka', 'Class of 2028']} />

  <section data-sec="origin" data-secname="Origin">
    <Chapter num="01" title="How I got here" />
    <div class="prose" data-anim style="font-size:18px">
      <p>I grew up in Sri Lanka and moved to Edmonton for university. I study computer engineering, and right now I also work as a junior curriculum developer at the University of Alberta, working on ways to make learning more effective.</p>
      <p>I build because I love solving problems. If a tool I need doesn’t exist, making it is the most fun way I know to learn. Most of what I know came from trial and error, which is also why I give away what I learn: if I already paid for the mistake, you don’t have to.</p>
      <p>I’m quiet until you get to know me, and I care a lot about the people close to me. Mostly, I like making things that leave someone a little better off.</p>
    </div>
  </section>
  <section id="skills" data-sec="skills" data-secname="Skills">
    <Chapter num="02" title="What I work in" sub="Evidence, not ratings. Click any row." />
    <SkillsExplorer />
  </section>

  {TERM.courses.length > 0 && (
    <section id="term" data-sec="term" data-secname="This term">
      <Chapter num="—" title="This term" sub={`${TERM.label}. What I’m taking, and what I think of it so far.`} />
      <div class="res">
        {TERM.courses.map((c, i) => (
          <div class="ritem" data-anim style={`--i:${i}`} data-lane-item="study">
            <div><h3>{[c.code, c.name].filter(Boolean).join(' — ')}</h3>{c.take && <p>{c.take}</p>}</div>
            <span class="rtype">{TERM.label}</span>
          </div>
        ))}
      </div>
    </section>
  )}

  <section data-sec="timeline" data-secname="Timeline">
    <Chapter num="03" title="Timeline" sub="Short, because it’s still early." />
    <div class="tl">
      {tl.map((t, i) => (
        <div class="tlrow" data-anim style={`--i:${i}`} data-lane-item={t.data.lane === 'life' ? undefined : t.data.lane}>
          <time>{t.data.when}</time><i class={`tldot ${t.data.lane}`}></i>
          <div><h3>{t.data.title}</h3><p>{t.data.text}</p></div>
          <span class="rt">{t.data.tag}</span>
        </div>
      ))}
    </div>
  </section>

  <section data-sec="learning" data-secname="Learning">
    <Chapter num="04" title="Languages" />
    <div class="langs">
      {NOW.panel.languages.map((l, i) => (
        <div class="lang" data-anim style={`--i:${i}`}><span>{l.name}</span><span class="bar" style={`--p:${l.pct}%`}><i></i></span><span>{l.note}</span></div>
      ))}
    </div>
  </section>

  <section data-sec="hobbies" data-secname="Off-screen">
    <Chapter num="05" title="Off-screen" />
    <div class="grid3">
      {HOBBIES.map((h, i) => (
        <div class="card" data-anim style={`--i:${i}`}><span class="kcount">{h.k}</span><h3>{h.title}</h3><p>{h.text}</p></div>
      ))}
    </div>
  </section>

  <section data-sec="elsewhere" data-secname="Elsewhere">
    <Chapter num="06" title="Elsewhere" sub="Everywhere else I leave a trail. Numbers refresh on every deploy." />
    <Elsewhere />
  </section>

  <section data-sec="photos" data-secname="Photos">
    <Chapter num="07" title="Photos" sub="Mostly nature. More on Pexels." more={{ href: '/photos', label: 'Full gallery' }} />
    <div class="strip">
      {strip.map((p) => (
        <button class="ph" type="button" data-cap={p.cap} data-meta={p.meta} data-src={p.full ?? p.src}>
          {p.src && <img src={p.src} alt={p.cap} loading="lazy" />}
          {!p.src && <><b>{p.label}</b><small>{p.meta.split('·')[1]?.trim()}</small></>}
        </button>
      ))}
    </div>
    {!livePhotos.length && !PHOTOS.some((p) => p.src) && <p class="quiet" style="margin-top:16px">Photos coming — <a href={PROFILES.pexels.url}>see them on Pexels</a></p>}
  </section>

  <div class="lb" id="lb" role="dialog" aria-modal="true" aria-label="Photo">
    <button class="lb-x">ESC ×</button>
    <div class="lb-in">
      <div class="lb-img" id="lbimg">photo</div>
      <div class="lb-cap"><span id="lbcap"></span><span class="lbl" id="lbmeta"></span></div>
    </div>
  </div>
</Base>
<script>
  import { $, $$ } from '../scripts/util';
  const lb = $('#lb');
  if (lb) {
    const cap = $('#lbcap')!, meta = $('#lbmeta')!, img = $('#lbimg')!;
    let last: HTMLElement | null = null;
    const close = () => { lb.classList.remove('show'); last?.focus(); };
    $$('.ph').forEach((p) => p.addEventListener('click', () => {
      last = p; cap.textContent = p.dataset.cap || ''; meta.textContent = p.dataset.meta || '';
      img.innerHTML = p.dataset.src ? `<img src="${p.dataset.src}" alt="">` : 'photo';
      lb.classList.add('show'); lb.querySelector<HTMLElement>('.lb-x')!.focus();
    }));
    lb.addEventListener('click', (e) => { const t = e.target as Element; if (t === lb || t.classList.contains('lb-x')) close(); });
    addEventListener('keydown', (e) => { if (e.key === 'Escape' && lb.classList.contains('show')) close(); });
  }
</script>
