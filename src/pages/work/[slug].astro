---
import Base from '../../layouts/Base.astro';
import { render } from 'astro:content';
import { projects, fmtDate } from '../../lib/content';
import { appstore, github } from '../../lib/live';
import Phone from '../../components/Phone.astro';

export async function getStaticPaths() {
  const all = await projects();
  return all.map((p, i) => ({ params: { slug: p.id }, props: { p, prev: all[(i - 1 + all.length) % all.length], next: all[(i + 1) % all.length] } }));
}
const { p, prev, next } = Astro.props;
const { Content, headings } = await render(p);
const d = p.data;
const app = d.appstore ? await appstore() : null;
const gh = await github();
const repo = d.repo ?? gh?.repos.find((r) => r.name.toLowerCase() === p.id)?.url;
const links = [...d.links, ...(repo && !d.links.some((l) => l.href === repo) ? [{ label: 'Repo', href: repo, primary: false }] : [])];
const shots = app?.screenshots?.length ? app.screenshots.map((src, i) => ({ src, label: d.shots[i] ?? '' })) : d.shots.map((label) => ({ src: undefined, label }));
const toc = [...headings.filter((h) => h.depth === 2), ...(shots.length ? [{ depth: 2, slug: 'screens', text: 'Screens' }] : [])];
---
<Base title={d.title} description={d.summary} lanes={false} bodyClass={`acc-${d.accent}`}>
  <div class={`phead cs-hero acc-${d.accent}`} data-sec="top" data-secname="Top">
    <nav class="crumb" aria-label="Breadcrumb"><a href="/">Home</a><span class="sep">/</span><a href="/work">Work</a><span class="sep">/</span><span aria-current="page">{d.title}</span></nav>
    <h1 class="rv cs-title"><span>{d.title}</span></h1>
    {app && (
      <a class="appchip" href={app.url} target="_blank" rel="noopener">
        {app.icon ? <img src={app.icon} alt="" width="44" height="44" /> : <span class="appchip-ph" aria-hidden="true">{d.title[0]}</span>}
        <span class="appchip-t"><b>Live on the App Store · testing on Google Play</b><small>v{app.version} · updated {fmtDate(new Date(app.updated), { month: 'short', day: 'numeric', year: 'numeric' })}{app.rating ? ` · ★ ${app.rating.toFixed(1)} (${app.ratings})` : ''} · {app.price}</small></span>
        <span class="live"><i class="dot"></i>Live</span>
      </a>
    )}
    <p class="lede-xl" set:html={d.lede} />
    <div class="quick">
      {links.map((l) => <a class={`btn mag ${l.primary ? 'primary' : ''}`} href={l.href} aria-disabled={l.href === '#' ? 'true' : undefined}>{l.label} ↗</a>)}
      <span class="chips" style="align-self:center;margin-left:6px">{d.stack.map((s) => <span class="chip">{s}</span>)}</span>
    </div>
    {d.stats.length > 0 && (
      <div class="stats" style="margin-top:clamp(44px,7vw,90px)">
        {d.stats.map((s, i) => (
          <div class={`stat ${i === 0 ? (d.accent === 'study' ? 's' : 'b') : ''}`} data-anim style={`--i:${i}`}>
            <b>{s.count != null ? <span class="count" data-to={s.count}>0</span> : s.value}</b><span>{s.label}</span>
          </div>
        ))}
      </div>
    )}
  </div>

  <section style="padding-top:clamp(50px,6vw,90px)" data-sec="study" data-secname="Case study" class={`acc-${d.accent}`}>
    <div class="split">
      <nav class="sidenav" aria-label="Sections">
        <span class="lbl">Contents</span>
        {toc.map((h, i) => <a href={`#${h.slug}`} class={i === 0 ? 'on' : ''}>{h.text}</a>)}
      </nav>
      <div class="prose cs-body">
        <Content />
        {shots.length > 0 && (
          <>
            <h2 id="screens">Screens</h2>
            <div class="phones">{shots.map((s, i) => <Phone src={s.src} label={s.label} i={i} tilt={(i - (shots.length - 1) / 2) * 3} />)}</div>
            {app?.screenshots?.length ? <p class="quiet">From the App Store listing · refreshed every build</p> : <p class="quiet">Placeholders{d.appstore ? ' — replaced automatically by App Store screenshots on deploy' : ` — drop captures in public/work/${p.id}/`}</p>}
          </>
        )}
        <nav class="pnav" aria-label="More work">
          <a href={`/work/${prev.id}`}><span class="lbl">← Previous</span><b>{prev.data.title}</b></a>
          <a href={`/work/${next.id}`}><span class="lbl">Next →</span><b>{next.data.title}</b></a>
        </nav>
      </div>
    </div>
  </section>
</Base>
